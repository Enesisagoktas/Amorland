<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Unity 6, C# 9 kullanir. Daha yenisini yazarsak Unity'de derlenmez. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Amorland.Dogrulama</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0067;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../istemci/Assets/Amorland/Kod/**/*.cs" />
    <Compile Include="../../../istemci/Assets/Amorland/Editor/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UnityStub/UnityStub.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
